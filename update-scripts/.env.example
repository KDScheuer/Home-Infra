# Settings for lxc-docker-image-updater.py, lxc-os-updater.py and pve-rolling-updater.py
#
#   cp .env.example .env    then fill in the REQUIRED section below.
#
# Format: KEY=value, one per line. Lists are comma-separated. Times are in seconds.
# Anything left blank or commented out uses the default shown.
# A real environment variable with the same name overrides this file.

# ===== REQUIRED ===============================================================

# IP addresses of your Proxmox nodes (comma-separated). Use IPs, not hostnames,
# so the scripts keep working while your DNS server's CT is restarting.
# The scripts connect to the first one that answers and find the rest of the cluster from there.
PVE_NODES=192.168.1.11,192.168.1.12,192.168.1.13

# User the scripts SSH in as on every node. Needs passwordless sudo
# (or use root - then sudo is skipped automatically).
SSH_USER=your-ssh-user

# Private key for that user (must already be in ~/.ssh/authorized_keys on every node).
SSH_KEY=~/.ssh/id_ed25519

# ===== OPTIONAL: SSH ==========================================================

# SSH port on the nodes (blank = 22 / whatever ~/.ssh/config says).
SSH_PORT=

# The scripts run ssh with BatchMode, so an unknown host key fails instead of prompting.
# Set to accept-new to trust each node's key on first connect, or leave blank and
# ssh to every node by hand once first.
SSH_STRICT_HOST_KEY_CHECKING=

# Command used to elevate on the nodes. Default: "sudo -n", or nothing if SSH_USER=root.
# SSH_SUDO=sudo -n

# Where run logs go. Default: a logs/ folder next to the scripts.
# UPDATER_LOG_DIR=~/proxmox-updater-logs

# ===== LXC scripts (docker + os) ==============================================

# CTs (or Compose projects) to update LAST, one at a time, in this order.
# Matched as a case-insensitive substring of the name - typically your DNS and
# reverse proxy, so everything else is done before they restart.
# Example: LXC_RUN_LAST=adguard,traefik
LXC_RUN_LAST=

# ===== lxc-docker-image-updater.py ============================================

# Compose project names or CT names (exact) to never touch.
DOCKER_EXCLUDE=

# DOCKER_PARALLEL=4                   # concurrent image pulls
# DOCKER_DISCOVER_PARALLEL=2          # concurrent CT probes (pct exec is slow under load)
# DOCKER_DISCOVER_TIMEOUT=90          # per CT, retried once
# DOCKER_PULL_TIMEOUT=1800
# DOCKER_UP_TIMEOUT=600
# DOCKER_HEALTH_TIMEOUT=180           # wait for containers to be running/healthy
# DOCKER_INSPECT_TIMEOUT=180

# ===== lxc-os-updater.py ======================================================

# CT names (exact) to never touch.
LXC_OS_EXCLUDE=

# LXC_OS_PARALLEL=4                   # concurrent refresh/download jobs
# LXC_OS_UPGRADE_PARALLEL=3           # concurrent installs (LXC_RUN_LAST ones go one by one)
# LXC_OS_DISCOVER_PARALLEL=2
# LXC_OS_DISCOVER_TIMEOUT=90
# LXC_OS_REFRESH_TIMEOUT=900
# LXC_OS_UPGRADE_TIMEOUT=1800
# LXC_OS_SETTLE_TIMEOUT=300           # docker containers / CT back after upgrade or reboot

# ===== pve-rolling-updater.py =================================================

# true  = always put a node in HA maintenance mode (evacuate guests) before upgrading
# false = only when it's going to reboot
# PVE_UPDATE_MAINT_ALWAYS=true

# Abort a node if apt dist-upgrade would remove any of these packages.
# PVE_UPDATE_PROTECTED=proxmox-ve,pve-manager

# PVE_UPDATE_REFRESH_TIMEOUT=900
# PVE_UPDATE_UPGRADE_TIMEOUT=1800
# PVE_UPDATE_EVAC_TIMEOUT=1800        # HA moving guests off the node
# PVE_UPDATE_MIGRATE_TIMEOUT=1800     # per non-HA guest migration
# PVE_UPDATE_BOOT_TIMEOUT=900
# PVE_UPDATE_SETTLE_TIMEOUT=900       # HA / Ceph settling after the node returns
